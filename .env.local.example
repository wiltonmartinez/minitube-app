# Copia este archivo como .env.local y pega tu clave de fal.ai (https://fal.ai/dashboard/keys).
# Sin FAL_KEY la app funciona en MODO SIMULACIÓN (imagen de prueba, sin costo).
FAL_KEY=
# (Opcional) Para ver tus créditos: la consulta de saldo exige una clave con alcance «Admin» (fal.ai/dashboard/keys).
# Si no la pones, se intenta con FAL_KEY y, si esta no tiene alcance Admin, la app te lo explica.
FAL_ADMIN_KEY=

# Token de la API v1 de miniaturas (/api/v1/thumbnail). Genera uno largo y aleatorio; el mismo valor va en TexTube.
MINITUBE_API_TOKEN=

# (Opcional, solo para pruebas) 1 = la API v1 responde siempre en modo simulación, aunque FAL_KEY exista.
MINITUBE_FORZAR_SIMULACION=

# (Opcional) Modelo de la prioridad NORMAL: «flux-2-pro» (por defecto), «nano-banana-pro», «gpt-image-2»,
# «seedream-5-pro» o «manual» (no genera nada y devuelve el prompt de Gemini para hacerlo a mano).
MINITUBE_MODELO_NORMAL=

# TexTUBE (títulos y descripciones de YouTube). Credenciales de la cuenta del canal (OAuth). Privadas.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Contraseña para entrar a TexTUBE en la web publicada (en local no se pide). Opcional: GESTOR_SECRETO firma la sesión.
GESTOR_CLAVE=
GESTOR_SECRETO=

# Correo(s) autorizados para entrar (separados por coma). Con esto se pide correo + contraseña y aparece «¿Olvidaste la contraseña?».
GESTOR_EMAIL=
# Envío del enlace de recuperación (https://resend.com, plan gratis): crea una API key con el mismo correo con el que te registres.
# Sin dominio propio verificado, Resend solo entrega a ese correo: justo lo que hace falta aquí.
RESEND_API_KEY=
GESTOR_CORREO_DE=
# Dirección pública del sitio (para armar el enlace del correo), p. ej. https://minitube-app.vercel.app
GESTOR_URL=

# Panel «Cuenta de usuario» en internet: base de datos Upstash Redis (gratis; en Vercel: Storage → Marketplace → Upstash Redis).
# En tu PC no hace falta: la cuenta se guarda en la carpeta .data. Opcional GESTOR_DATOS_DIR para elegir otra carpeta.
KV_REST_API_URL=
KV_REST_API_TOKEN=
